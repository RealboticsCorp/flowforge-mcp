# FlowForge MCP server configuration.
# Copy to .env (or export these in your shell / MCP client config).

# Required: your FlowForge API key (format: ff_live_...).
# Create one in the FlowForge dashboard under Settings -> API Keys.
FLOWFORGE_API_KEY=ff_live_your_api_key_here

# Optional: override the API base URL (defaults to the production URL).
# FLOWFORGE_BASE_URL=https://api.realbotics.ai/api/v1/external
